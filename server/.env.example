# Copy to .env on the VPS and fill in. All fields are required unless commented.
POSTGRES_PASSWORD=
LOG_LEVEL=info
# 1 if behind a reverse proxy (nginx/caddy) that sets x-forwarded-for
TRUST_PROXY=0
# Full origin, e.g. https://tally.example.com
PUBLIC_BASE_URL=
HCA_CLIENT_ID=
HCA_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# 32 bytes base64: openssl rand -base64 32
BUNDLE_KEY=
# Omit BUNDLE_BUCKET and S3_* entirely to store bundles in Postgres (dev).
# For a real bucket (prod): set BUNDLE_BUCKET + creds below.
BUNDLE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional, for non-AWS providers e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=
