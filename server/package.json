{
  "name": "tally-server",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "migrate": "bun scripts/migrate.ts",
    "build:landing": "tailwindcss -i tailwind/landing.src.css -o static/landing.css --minify",
    "token:create": "bun scripts/token.ts create",
    "token:revoke": "bun scripts/token.ts revoke",
    "token:claim": "bun scripts/token.ts claim",
    "user:role": "bun scripts/user-role.ts",
    "db:reset": "psql \"$DATABASE_URL\" -c \"drop schema public cascade; create schema public\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "wasm": "wasm-pack build ../crates/tally-scoring --target nodejs --out-dir ../../server/wasm --out-name tally_scoring --features wasm",
    "fixture": "cargo run -q -p tally-scoring --example server_fixture > test/fixtures/chain.json"
  },
  "dependencies": {
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/cli": "^4.3.5",
    "@types/bun": "1.4.5",
    "tailwindcss": "4",
    "typescript": "7.0.2"
  }
}
