#!/usr/bin/env bash
# Claude Code SessionStart hook. Prints only hook JSON, never waits for a download, always exits 0.
# `session-start tally <args>` runs the located tally binary instead (used by the slash commands).
exec 2>/dev/null
ROOT=${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}
VER=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ROOT/.claude-plugin/plugin.json" | head -n1)

if [ -n "${TALLY_HOME:-}" ]; then HOME_DIR=$TALLY_HOME
else case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) HOME_DIR=$(cygpath -u "${LOCALAPPDATA:-$HOME/AppData/Local}" 2>/dev/null || echo "$HOME/AppData/Local")/tally ;;
  Darwin) HOME_DIR=$HOME/Library/Application\ Support/tally ;;
  *) HOME_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/tally ;;
esac; fi
LOG=$HOME_DIR/ensure.log
note() { mkdir -p "$HOME_DIR" && echo "$(date -u +%FT%TZ) session-start: $*" >> "$LOG"; }

# `tally --version` of $1 is at least $VER.
fresh() { local v; v=$("$1" --version | sed -n 's/[^0-9]*\([0-9][0-9.]*\).*/\1/p' | head -n1)
  # The current tally has no --version flag (daemon crate untouched here): with no version, accept a binary that knows `ensure`.
  if [ -z "$v" ]; then "$1" ensure --help >/dev/null; return; fi
  [ "$(printf '%s\n%s\n' "$v" "$VER" | sort -V | head -n1)" = "$VER" ]; }
find_tally() { local c; for c in "$HOME_DIR/bin/tally.exe" "$HOME_DIR/bin/tally"; do [ -x "$c" ] && { echo "$c"; return; }; done; command -v tally; }

if [ "${1:-}" = tally ]; then shift; B=$(find_tally); [ -n "$B" ] && exec "$B" "$@"; echo "tally is not installed; reinstall the Tally plugin."; exit 0; fi

trap 'exit 0' EXIT
B=$(find_tally)
if [ -n "$B" ] && fresh "$B"; then
  "$B" ensure --client claude-code --register-cwd "${CLAUDE_PROJECT_DIR:-$PWD}" --hook-json || note "ensure failed"
  exit 0
fi

INST=$ROOT/install/install.sh
if [ ! -f "$INST" ]; then
  note "no usable tally and no installer in $ROOT/install"
  echo '{"systemMessage": "Tally is not installed and the plugin has no installer. Reinstall the Tally plugin."}'
  exit 0
fi
# Detached: download, then ensure with the fresh binary. Output goes to the log, never to the hook's stdout.
export TALLY_VERSION=$VER TALLY_INSTALL_DIR=$HOME_DIR/bin
mkdir -p "$HOME_DIR" || exit 0
(
  if bash "$INST" --binary-only; then
    N=$(find_tally); if [ -n "$N" ] && fresh "$N"; then "$N" ensure --client claude-code --register-cwd "${CLAUDE_PROJECT_DIR:-$PWD}" --hook-json >/dev/null; else note "installed binary missing or too old"; fi
  else
    note "installer failed (exit $?) for version $VER"
  fi
) </dev/null >>"$LOG" 2>&1 &
disown 2>/dev/null
echo "{\"systemMessage\": \"Tally is installing (version $VER); tracking starts in a minute. See $LOG if it does not.\"}"
